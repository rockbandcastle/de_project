# ===== Общие =====
COMPOSE_PROJECT_NAME=mfc_analytics
TZ=Europe/Moscow

# ===== PostgreSQL (OLTP) =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mfc_oltp
POSTGRES_USER=mfc_user
POSTGRES_PASSWORD=change_me_postgres

# ===== ClickHouse (OLAP) =====
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
CLICKHOUSE_DB=mfc_olap
CLICKHOUSE_USER=mfc_user
CLICKHOUSE_PASSWORD=change_me_clickhouse

# ===== MinIO (S3) =====
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
S3_ENDPOINT=http://minio:9000
S3_BUCKET_RAW=mfc-raw
S3_BUCKET_PARQUET=mfc-parquet
S3_BUCKET_ICEBERG=mfc-iceberg

# ===== MongoDB (источник) =====
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=mfc_source
MONGO_USER=mfc_user
MONGO_PASSWORD=change_me_mongo

# ===== Airflow =====
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/airflow
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__SECRET_KEY=change_me_airflow_secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_airflow
AIRFLOW_WEBSERVER_PORT=8080

# ===== Superset =====
SUPERSET_SECRET_KEY=change_me_superset_secret
SUPERSET_PORT=8088

# ===== Qdrant =====
QDRANT_HOST=qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ===== Trino =====
TRINO_PORT=8081

# ===== Kafka / Debezium =====
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_PORT=9092

# ===== Prometheus / Grafana =====
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# ===== MLflow =====
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://mlflow:5000

# ===== LLM =====
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
